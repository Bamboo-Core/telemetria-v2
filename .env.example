###############################################################################
# Configuração de ambiente — copie para .env (o instalar.sh faz isso por você).
# NUNCA versione o .env (já está no .gitignore).
###############################################################################

# --- InfluxDB v2 ------------------------------------------------------------
# Deixe "trocar-me": o instalar.sh gera o token e a senha admin e preenche aqui.
INFLUX_TOKEN=trocar-me
INFLUX_ORG=kuantics
INFLUX_BUCKET=telemetria

# Usuário/senha do admin da UI do InfluxDB v2 (http://IP_DA_VM:8086).
# Deixe "trocar-me" na senha: o instalar.sh gera uma aleatória.
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=trocar-me

# URL usada pelo Telegraf-Huawei (roda em network_mode: host → fala com a VM).
# O Telegraf-gNMI usa a rede interna do compose e ignora isto.
INFLUX_URL=http://127.0.0.1:8086

# --- Imagem Huawei (opcional) -----------------------------------------------
# Por padrão baixa a imagem já publicada no GHCR. Sobrescreva só se necessário.
# HUAWEI_IMAGE=ghcr.io/bamboo-core/telemetria:latest

# --- Credenciais gNMI (cadastro manual de equipamentos) ---------------------
# Use estas variáveis nos arquivos que você copiar de exemplos/ para telegraf.d/.
# Se equipamentos do mesmo fabricante usarem credenciais diferentes, crie um
# arquivo por equipamento e preencha direto nele (sem commitar).
JUNIPER_USER=
JUNIPER_PASS=
ARISTA_USER=
ARISTA_PASS=
CISCO_USER=
CISCO_PASS=
NOKIA_USER=
NOKIA_PASS=
